{
  "metadata": {
    "project": "audio-file-level membership inference",
    "target_year": "2026",
    "applied_filters": {
      "duration": "Queries explicitly include terms like 'clip', 'short', 'summary', 'highlights', or 'excerpt' to bias YouTube's algorithm toward videos under 20-30 minutes. Raw, multi-hour proceedings have been replaced with summarized or analytical formats.",
      "terminology": "All instances of 'audio', 'audio only', and 'recording(s)' have been replaced with 'video', 'clip', 'footage', or 'narration' to align with YouTube search behavior.",
      "content_density": "Queries are optimized for speech-heavy, continuous dialogue or commentary (e.g., Q&A, analysis, tutorials, debates) to minimize long periods of silence.",
      "timestamp": "The 'sp=EgIIAQ%3D%3D' parameter in each URL enforces YouTube's 'Upload date: This year' (2026) filter."
    },
    "programmatic_download_tip": "When using yt-dlp, combine these queries with '--match-title \"(short|clip|summary|highlights|excerpt)\"' and '--dateafter 20260101' for maximum precision."
  },
